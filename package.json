{
  "name": "brake-or-break",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "hidtest": "esbuild scripts/hidtest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/hidtest.mjs --log-level=warning && node node_modules/.cache/hidtest.mjs",
    "simtest": "esbuild scripts/simtest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/simtest.mjs --log-level=warning && node node_modules/.cache/simtest.mjs"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vite": "5.4.10"
  },
  "dependencies": {
    "@fontsource/bangers": "5.3.0"
  }
}
